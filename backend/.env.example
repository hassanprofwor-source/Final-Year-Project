PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=Cluster0
# If Node fails with querySrv ECONNREFUSED, use Atlas standard (non-SRV) URI instead.

CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FRONTEND_URL=http://localhost:5173

SMTP_SERVICE=gmail
SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_MAIL=
SMTP_PASSWORD=
OPENWEATHER_API_KEY=
# Fallback city if the phone does not share location (1177654 = Lahore)
OPENWEATHER_CITY_ID=1177654
ML_SERVICE_URL=http://localhost:5001
# Restaurant's local timezone, used to bucket orders by hour in the Node
# analytics fallback. Must match ANALYTICS_TZ in ml-service/.env.
ANALYTICS_TZ=Europe/London
