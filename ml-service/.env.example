MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGO_DB_NAME=Skyplate
PORT=5001

# Restaurant's local timezone. Mongo stores UTC; orders are bucketed by the
# wall clock here, so this must match the venue or every hour will be off.
ANALYTICS_TZ=Europe/London

# Trading window. Leave both unset to detect it from the order history.
# SERVICE_HOUR_START=12
# SERVICE_HOUR_END=22

# Rolling window of history used for training.
TRAIN_WINDOW_DAYS=180

# Nightly retrain. A worse model is rejected by the champion/challenger check.
ENABLE_SCHEDULED_RETRAIN=true
RETRAIN_AT=03:30

# Set to "fast" to shrink the hyperparameter grid on low-powered hosts.
TUNING_PROFILE=full
